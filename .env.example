# Perplexity AI Configuration
PERPLEXITY_API_KEY=pxl_your_key_here
PERPLEXITY_MODEL=sonar-huge
PERPLEXITY_TIMEOUT=30

# GitHub Configuration (for backend fetching)
GITHUB_TOKEN=ghp_your_token_here

# Project Context
WATCHED_REPOS=git@github.com:Amitro123/GithubAgent.git,git@github.com:Amitro123/DevLens-AI.git

# Local checkouts the code agent may read (via its MCP repo tools). Key is either the
# GitHub owner/repo or the host of the page being analyzed (e.g. a local dev server).
# Without a match the code agent runs prompt-only, with no file access.
REPO_PATHS=Amitro123/DevLens-AI=/path/to/DevLens-AI,localhost:3000=/path/to/my-app

# LLM response cache: one JSON file per cached call. Safe to delete at any time.
LLM_CACHE_DIR=~/.codereview-agent/cache
# How long cached LLM responses stay valid, in hours (0 disables caching).
LLM_CACHE_TTL_HOURS=24

# Project knowledge base (wiki + graph + raw runs). "repo" keeps it in <project>/.codereview-kb
# for projects mapped in REPO_PATHS (commit it, like agent-brain's shared memory); "central"
# always uses KB_DIR. Unmapped projects always use KB_DIR.
KB_LOCATION=repo
KB_DIR=~/.codereview-agent/kb

# LLM provider for the agents. Any OpenAI-compatible API works:
#   openrouter (default) - one key, any model on https://openrouter.ai/models
#   groq                 - GROQ_API_KEY (used automatically if it's the only key set)
#   custom               - e.g. Ollama/LM Studio: LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your_key_here
# Models, as the provider names them. LLM_MODEL sets all three; the specific ones win.
# VISION_MODEL must accept images; CODE_MODEL must support tool calling.
# LLM_MODEL=google/gemini-2.5-flash
# VISION_MODEL=google/gemini-2.5-flash
# CODE_MODEL=google/gemini-2.5-flash
# TEXT_MODEL=google/gemini-2.5-flash

# Problem classifier: decides which agent handles each problem (see agents.yaml).
# By default it's Jev (TypeSafe's calibrated decision model) through OpenRouter, with the
# OPENROUTER_API_KEY above - nothing else to set. Without OpenRouter, set TYPESAFE_API_KEY to
# call TypeSafe directly; with neither, one LLM call classifies instead (uncalibrated).
# CLASSIFIER=llm              # skip Jev and always use the LLM classifier
# TYPESAFE_API_KEY=
# CLASSIFIER_BASE_URL=        # another System One endpoint, e.g. a gateway
# CLASSIFIER_API_KEY=
# CLASSIFIER_MODEL=jev-latest
# AGENTS_CONFIG=agents.yaml   # agent profiles and routing thresholds

IDE_WS_URL=ws://localhost:8080

# Feature Toggles
VOICE_ENABLED=false
AUTO_SCRAPE_LOGS=true
