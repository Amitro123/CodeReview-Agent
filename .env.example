# Perplexity AI Configuration
PERPLEXITY_API_KEY=pxl_your_key_here
PERPLEXITY_MODEL=sonar-huge
PERPLEXITY_TIMEOUT=30

# GitHub Configuration (for backend fetching)
GITHUB_TOKEN=ghp_your_token_here

# Project Context
WATCHED_REPOS=git@github.com:Amitro123/GithubAgent.git,git@github.com:Amitro123/DevLens-AI.git

# MCP Server Configuration
MCP_SERVERS=localhost:5000,localhost:5001

# Groq AI Configuration (Multi-Agent CI + screenshot vision analysis)
GROQ_API_KEY=gsk_your_key_here
# Must be a vision-capable model - check https://console.groq.com/docs/models
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
IDE_WS_URL=ws://localhost:8080

# Feature Toggles
VOICE_ENABLED=false
AUTO_SCRAPE_LOGS=true
